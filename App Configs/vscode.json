{
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "explorer.sortOrder": "type",
  "workbench.layoutControl.type": "toggles",
  "workbench.startupEditor": "none",
  "terminal.integrated.cursorBlinking": true,
  "editor.minimap.renderCharacters": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "files.enableTrash": false,
  "editor.minimap.side": "left",
  "editor.minimap.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "extensions.ignoreRecommendations": true,
  "scm.diffDecorationsGutterVisibility": "hover",
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.showPushSuccessNotification": true,
  "editor.fontFamily": "CaskaydiaCove NF mono, CaskaydiaCove Nerd Font Mono, Cascadia code , Consolas",
  "terminal.integrated.fontFamily": "CaskaydiaCove NF mono,CaskaydiaCove Nerd Font Mono, Cascadia Mono, Consolas",
  "editor.fontLigatures": true,
  "editor.codeLens": false,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.quickSuggestions": {
    "other": "on",
    "strings": "on",
    "comments": "on"
  },
  "git.confirmSync": false,
  "explorer.incrementalNaming": "smart",
  "debug.inlineValues": "on",
  "window.autoDetectColorScheme": true,
  "workbench.editor.splitInGroupLayout": "vertical",
  "debug.internalConsoleOptions": "neverOpen",
  "debug.openDebug": "neverOpen",
  "debug.terminal.clearBeforeReusing": true,
  "css.lint.duplicateProperties": "warning",
  "less.lint.duplicateProperties": "warning",
  "scss.lint.duplicateProperties": "warning",
  "editor.suggest.showDeprecated": false,
  "problems.showCurrentInStatus": true,
  "emmet.triggerExpansionOnTab": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "errorLens.gutterIconSet": "defaultOutline",
  "errorLens.gutterIconSize": "80%",
  "workbench.editor.highlightModifiedTabs": true,
  "scm.alwaysShowRepositories": true,
  "scm.alwaysShowActions": true,
  "git.decorations.enabled": false,
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.foldingMaximumRegions": 50000,
  "terminal.integrated.altClickMovesCursor": false,
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  "git.postCommitCommand": "push",
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.copyOnSelection": true,
  "editor.guides.bracketPairs": true,
  "git.allowForcePush": true,
  "search.defaultViewMode": "tree",
  "debug.console.fontFamily": " CaskaydiaCove NF mono, Cascadia code , Consolas",
  "scm.defaultViewMode": "tree",
  "scm.countBadge": "off",
  "files.exclude": {
    "**/.git": false,
    "**/.ignore": true,
    "**/desktop.ini": true
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": [
        "-NoLogo"
      ]
    }
  },
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.minimumContrastRatio": 1,
  "php.suggest.basic": false,
  "php.validate.enable": false,
  "emmet.excludeLanguages": [
    "markdown",
    "php"
  ],
  "diffEditor.wordWrap": "on",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.enabled": true,
  "editor.renderLineHighlight": "all",
  "editor.mouseWheelZoom": true,
  "html.format.wrapLineLength": 0,
  "html.format.wrapAttributes": "preserve",
  "html.format.templating": true,
  "markdown.preview.breaks": true,
  "markdown.validate.enabled": true,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "json.trace.server": "messages",
  "editor.inlayHints.padding": true,
  "debug.console.acceptSuggestionOnEnter": "on",
  "debug.showInStatusBar": "never",
  "debug.showSubSessionsInToolBar": true,
  "terminal.external.windowsExec": "wt",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.foldingHighlight": false,
  "files.eol": "\n",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "right"
  },
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  "npm.packageManager": "pnpm",
  "git.ignoreRebaseWarning": true,
  "editor.accessibilitySupport": "off",
  "editor.codeActionWidget.showHeaders": false,
  "editor.snippets.codeActions.enabled": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.organizeImports": "never"
  },
  "css.lint.unknownAtRules": "ignore",
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "markdown.preview.typographer": true,
  "markdown.updateLinksOnFileMove.enabled": "prompt",
  "markdown.validate.fragmentLinks.enabled": "ignore",
  "markdown.validate.referenceLinks.enabled": "ignore",
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "terminal.integrated.tabs.showActions": "always",
  "terminal.integrated.tabs.showActiveTerminal": "always",
  "notebook.cellToolbarVisibility": "hover",
  "scm.diffDecorations": "gutter",
  "scm.diffDecorationsGutterWidth": 1,
  "workbench.editor.languageDetectionHints": {
    "untitledEditors": false,
    "notebookEditors": false
  },
  "debug.console.collapseIdenticalLines": false,
  "explorer.fileNesting.expand": false,
  "workbench.layoutControl.enabled": false,
  "editor.insertSpaces": false,
  "editor.tabSize": 2,
  "editor.indentSize": 2,
  "markdown.preview.scrollEditorWithPreview": false,
  "markdown.preview.scrollPreviewWithEditor": false,
  "editor.autoClosingBrackets": "always",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "notebook.cellFocusIndicator": "border",
  "notebook.consolidatedRunButton": true,
  "notebook.globalToolbarShowLabel": "never",
  "notebook.globalToolbar": false,
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.useInlineCompletions": true,
  "git.openRepositoryInParentFolders": "never",
  "workbench.iconTheme": "material-icon-theme",
  "debug.console.closeOnEnd": true,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.env.windows": {},
  "errorLens.editorHoverPartsEnabled": {
    "buttonsEnabled": false
  },
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.parameterHints.enabled": false,
  "editor.inlineSuggest.suppressSuggestions": false,
  "breadcrumbs.enabled": false,
  "workbench.editor.labelFormat": "short",
  "workbench.tree.indent": 12,
  "workbench.editor.sharedViewState": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 3,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "editor.suggest.showInlineDetails": false,
  "editor.suggest.showWords": false,
  "update.showReleaseNotes": false,
  "window.commandCenter": false,
  "ipynb.pasteImagesAsAttachments.enabled": false,
  "workbench.list.smoothScrolling": true,
  "editor.smoothScrolling": true,
  "window.menuBarVisibility": "toggle",
  "files.associations": {
    ".env*": "dotenv",
    "*.postcss": "tailwindcss"
  },
  "editor.lightbulb.enabled": "off",
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "window.zoomLevel": 2,
  "window.density.editorTabHeight": "compact",
  "explorer.compactFolders": false,
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "terminal.integrated.enableVisualBell": true,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.editor.useModal": "off",
  "accessibility.verbosity.chatPetAchievements": false,
  "editor.wordWrap": "on",
  "editor.allowVariableFontsInAccessibilityMode": true,
}
